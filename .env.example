# Docker network and Bitcoin RPC
BITCOIN_DOCKER_NETWORK=bitcoinknots_default
BITCOIN_RPC_URL=http://bitcoin-knots:8332
BITCOIN_RPC_USER=dashboard
BITCOIN_RPC_PASSWORD_SECRET_FILE=./secrets/bitcoin_rpc_password

# Dashboard
DASHBOARD_IMAGE=docker-bitcoin-dashboard
DASHBOARD_IMAGE_TAG=local
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8335
NODE_NAME=bitcoin-knots
REFRESH_INTERVAL_SECONDS=30

# Optional integrations (disabled by default)
ELECTRS_ENABLED=false
ELECTRS_METRICS_URL=http://electrs:4224

TOR_ENABLED=false

MEMPOOL_EXPLORER_ENABLED=false
MEMPOOL_EXPLORER_URL=http://mempool:8080

# Optional host metrics and disk warnings
HOST_METRICS_ENABLED=false
CPU_TEMP_PATH=/sys/class/thermal/thermal_zone0/temp
LOADAVG_PATH=/proc/loadavg
DISK_MONITOR_PATH=
DISK_WARNING_FREE_GB=100
